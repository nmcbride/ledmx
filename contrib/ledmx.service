# systemd *user* unit for the ledmx display daemon.
#
# Install to ~/.config/systemd/user/ledmx.service, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now ledmx
#
# A user unit, not a system one: panel access comes from a uaccess ACL granted
# to the logged-in user, so a process running as that user has it for free. A
# system unit runs as root or a system user and would need group membership or
# a udev rule of its own.

[Unit]
Description=Framework 16 LED matrix display
Documentation=https://github.com/FrameworkComputer/inputmodule-rs
# Bound to the graphical session because the uaccess ACL only exists while a
# seat session is active. Outside one, the device node is unreadable.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# --wait tolerates starting before the seat session has been granted its ACL,
# which is common on login: the device node exists but is not yet readable.
ExecStart=%h/.nix-profile/bin/ledmx daemon --scene monitor --wait 90
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# The daemon holds two serial ports and renders frames; it needs nothing else.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
